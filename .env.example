# =============================================================================
# .env.example — copy this to .env and fill in real values.
# NEVER commit .env to git.
# =============================================================================

# ── Required ──────────────────────────────────────────────────────────────────

# Your Groq API key (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# ── Optional overrides ────────────────────────────────────────────────────────

# Comma-separated list of allowed CORS origins.
# The backend defaults to localhost dev ports when this is unset.
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional model override (defaults to qwen/qwen3.8-27b if unset)
# GROQ_MODEL=qwen/qwen3.8-27b

# Qdrant server URL. Set by docker-compose.yml automatically.
# Only override this if you run Qdrant somewhere other than the compose stack.
# QDRANT_URL=http://qdrant:6333

# Port to expose frontend on host (80 on EC2 production, 3000 on local dev)
# FRONTEND_PORT=80

# Image tag deployed by deploy.sh and CI/CD
# IMAGE_TAG=latest

# ── YouTube Proxy (for cloud-hosted deployments) ───────────────────────────────
# AWS / GCP / Azure IPs are blocked by YouTube's transcript API.
# Set this to a residential or rotating proxy to route transcript requests
# through an unblocked IP.  Leave unset for local dev (no proxy needed).
# Format: http://user:password@proxy-host:port
# YOUTUBE_PROXY=http://user:password@proxy-host:port


